<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CamInvest Hub</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#f2f4f7;padding-bottom:70px}
.header{background:#0b8a42;color:#fff;padding:15px;text-align:center;font-weight:bold;font-size:20px}
.card{background:#fff;margin:10px;border-radius:12px;padding:15px;box-shadow:0 2px 8px rgba(0,0,0,.1)}
.balance{font-size:28px;font-weight:bold;color:#0b8a42}
.btn{width:100%;padding:12px;border:0;border-radius:8px;font-weight:bold;cursor:pointer;margin-top:8px}
.btn-green{background:#0b8a42;color:#fff}
.btn-orange{background:#ff9800;color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.prod{border:1px solid #eee;border-radius:10px;padding:12px;text-align:center}
.prod b{color:#0b8a42}
