<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin - CamInvest</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#0a1931;color:#fff;padding:15px;min-height:100vh}
.box{background:#fff;color:#111;padding:14px;border-radius:14px;margin:10px 0}
input{width:100%;padding:12px;border-radius:10px;border:1px solid #ccc;margin:6px 0}
button{padding:12px 16px;border:0;border-radius:10px;font-weight:900;cursor:pointer}
.btnDark{background:#0a1931;color:#fff;width:100%}.btnGold{background:gold;color:#000}
h3{margin:15px 0 5px}
small{color:#666}
</style>
</head>
<body>
<div style="max-width:420px;margin:0 auto">
<h2 style="text-align:center">🔐 Admin Panel<br><small style="color:gold">678657567 - Ambokia Promise</small></h2>

<div id="loginBox" class="box">
<h3>Admin Login</h3>
<input id="pass" type="password" placeholder="Password: Promise123">
<button class="btnDark" onclick="login()">LOGIN</button>
<p style="font-size:11px;margin-top:6px">Keep this page secret! Link: /admin.html</p>
</div>

<div id="panel" style="display:none">
<div class="box">
<h3>💰 Add Balance (When user pays you)</h3>
<small>User must have registered on this same phone to work for demo. Real system uses database.</small>
<input id="uPhone" placeholder="User Phone e.g. 678...">
<input id="uAmt" type="number" placeholder="Amount e.g. 500">
<button class="btnDark" onclick="addBalance()">Add Balance + Confirm</button>
<p style="font-size:11px;margin-top:6px">In real production, you check your MoMo 678657567, then add here.</p>
</div>

<div class="box">
<h3>🏧 Withdraw Requests</h3>
<div id="wList"></div>
<button class="btnGold" onclick="load()" style="margin-top:8px">Refresh</button>
<button class="btnDark" style="margin-top:8px;background:red" onclick="clearW()">Clear All</button>
</div>

<div class="box">
<h3>👥 Current User On This Phone</h3>
<div id="userInfo"></div>
</div>

<div class="box">
<h3>📊 Stats</h3>
<div id="stats"></div>
</div>
</div>
</div>

<script>
function login(){
if(document.getElementById('pass').value==='Promise123'){
document.getElementById('loginBox').style.display='none';
document.getElementById('panel').style.display='block';
load();
}else alert('Wrong password! Use Promise123');
}
function load(){
let w=JSON.parse(localStorage.getItem('withdraws')||'[]');
document.getElementById('wList').innerHTML=w.length?w.map((x,i)=>`
<div style="border:1px solid #ccc;padding:10px;border-radius:10px;margin:6px 0">
<b>${x.phone}</b> wants <b>${x.amt}F</b><br>
<small>${x.date}</small><br>
<button onclick="pay(${i})" style="background:#25D366;color:#fff;padding:8px 12px;border-radius:20px;margin-top:5px">✅ Mark Paid & Send MoMo</button>
</div>
`).join(''):'<p>No withdraw requests on this device.<br><small>Real requests come via WhatsApp to 678657567 because each phone has its own storage. Later we connect database.</small></p>';

let phone=localStorage.getItem('phone')||'None';
let bal=localStorage.getItem('bal')||'0';
document.getElementById('userInfo').innerHTML=`Phone: ${phone}<br>Balance: ${bal}F<br>Orders: ${(JSON.parse(localStorage.getItem('orders')||'[]')).length}`;

let totalRecharge=w.reduce((s,x)=>s+0,0);
document.getElementById('stats').innerHTML=`Total Withdraw Requests: ${w.length}<br>MoMo Admin: 678657567`;
}

function addBalance(){
let ph=document.getElementById('uPhone').value.trim();
let amt=parseInt(document.getElementById('uAmt').value);
if(!ph||!amt)return alert('Fill phone and amount');
if(ph!==localStorage.getItem('phone'))return alert('DEMO LIMIT: This phone can only add to current user '+localStorage.getItem('phone')+'\n\nIn real app with database, you can add to any user.\n\nFor now, tell user to use same phone, or you add via database.');
let bal=parseInt(localStorage.getItem('bal')||'0');
bal+=amt;
localStorage.setItem('bal',bal);
alert(amt+'F added to '+ph+'. New balance: '+bal+'F');
load();
}
function pay(i){
let w=JSON.parse(localStorage.getItem('withdraws')||'[]');
let req=w[i];
if(confirm('You sent '+req.amt+'F to '+req.phone+' via MoMo?\nClick OK to remove request.')){
w.splice(i,1);
localStorage.setItem('withdraws',JSON.stringify(w));
window.location.href='https://wa.me/'+req.phone+'?text=Your withdrawal of '+req.amt+'F has been sent! Thanks for using CamInvest Hub';
setTimeout(load,1000);
}
}
function clearW(){if(confirm('Clear all?')){localStorage.setItem('withdraws','[]');load();}}
</script>
</body>
</html>
